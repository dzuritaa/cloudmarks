    {
      "case": "remote revision / clean local copy",
      "expected_result": "explicit fresh-ID refresh queues update; worker publishes verified version and retains prior bytes",
      "validation": "automated + dedicated OneDrive"
    },
    {
      "case": "unchanged revision / clean local copy",
      "expected_result": "fresh server checksum permits reuse; no download or publication",
      "validation": "automated + NTFS3"
    },
    {
      "case": "local edit / remote edit",
      "expected_result": "original object, modified visible file and verified remote candidate all retained; job blocked",
      "validation": "automated + NTFS3 + dedicated OneDrive"
    },
    {
      "case": "explicit dirty state",
      "expected_result": "matching visible bytes do not authorize replacement; preserve separate candidate",
      "validation": "automated + NTFS3"
    },
    {
      "case": "local rename",
      "expected_result": "renamed raw-store file retained; missing managed path not silently recreated",
      "validation": "automated + NTFS3"
    },
    {
      "case": "remote rename",
      "expected_result": "stable ID found at new path; original local path and remote candidate retained; online union blocked",
      "validation": "automated + NTFS3 + dedicated OneDrive"
    },
    {
      "case": "local deletion",
      "expected_result": "missing publication stays missing; original object and remote candidate retained",
      "validation": "automated + NTFS3"
    },
    {
      "case": "remote deletion / inaccessible stable ID",
      "expected_result": "account/root rechecked; absence marked ambiguous; no eviction, path reuse or remote cleanup",
      "validation": "automated + NTFS3 + dedicated OneDrive deletion fixture"
    },
    {
      "case": "remote path reused by different identity",
      "expected_result": "queued stable identity unchanged; replacement not hydrated over original",
      "validation": "automated + NTFS3"
    },
    {
      "case": "move outside allowed root",
      "expected_result": "scope verification fails; no deletion inferred and no bytes overwritten",
      "validation": "automated + NTFS3"
    },
    {
      "case": "failed account/root / 403 / 429 / 503",
      "expected_result": "no deletion inference from failed metadata or unavailable root",
      "validation": "automated"
    },
    {
      "case": "remote candidate changes during transfer",
      "expected_result": "candidate not indexed as complete; prior data/partial retained for retry",
      "validation": "automated + NTFS3"
    },
    {
      "case": "remote conflict candidate changes with same eTag",
      "expected_result": "fresh checksum defeats reuse; both indexed candidates retained",
      "validation": "automated + NTFS3"
    },
    {
      "case": "process termination / restart",
      "expected_result": "durable running job becomes pending; resume explicitly in a new process",
      "validation": "automated + NTFS3"
    },
    {
      "case": "cloud connection loss / restored worker process",
      "expected_result": "error intent retained; fresh worker completes after rejecting proxy removed",
      "validation": "automated + NTFS3 + dedicated OneDrive"
    },
    {
      "case": "disk absent / volume check restored",
      "expected_result": "guard stops before consuming queued intent; explicit resume completes after restored proof",
      "validation": "injected automated + NTFS3; no hardware unplug"
    },
    {
      "case": "cancellation",
      "expected_result": "pending job and old publication survive; explicit resume succeeds",
      "validation": "automated + NTFS3"
    },
    {
      "case": "insufficient conflict budget",
      "expected_result": "old bytes and issue retained; candidate capture retried after budget restored",
      "validation": "automated + NTFS3"
    },
    {
      "case": "folder incomplete/changed manifest",
      "expected_result": "two bounded matching scans required; failed/partial metadata commits roll back",
      "validation": "automated + NTFS3"
    },
    {
      "case": "folder listing omission",
      "expected_result": "existing snapshot retained; omission alone never becomes deletion",
      "validation": "automated + NTFS3"
    },
    {
      "case": "overlapping folder and direct pin intent",
      "expected_result": "unpin removes only its source; downloaded bytes and other sources survive",
      "validation": "automated + NTFS3"
    },
    {
      "case": "aggregate freshness/completeness/read path",
      "expected_result": "all recorded file paths verified; expired, missing or changed coverage unknown",
      "validation": "automated + NTFS3 + dedicated OneDrive offline mounts"
    },
    {
      "case": "status-only helper / read-only reports",
      "expected_result": "read-only SQLite does not recover jobs; status socket rejects action operations",
      "validation": "automated + native Files regression"
    },
    {
      "case": "physical network disconnect / disk unplug / full logout",
      "expected_result": "not performed; required before daily deployment",
      "validation": "pending operational acceptance"
